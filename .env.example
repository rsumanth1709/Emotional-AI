# ── MindCare AI Production Environment Configuration ──────────────────────
# Copy this file to .env and customize values for your deployment.

# 1. Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEBUG=False

# 2. AI & LLM Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=optional_openai_key_here

# 3. Domain & Reverse Proxy (Caddy)
# Set your production domain (e.g., mindcare.yourdomain.com) or 'localhost' if testing locally
DOMAIN=localhost
ACME_EMAIL=admin@yourdomain.com

# 4. Frontend & Backend URLs
FRONTEND_URL=https://localhost
NEXT_PUBLIC_API_URL=https://localhost

# 5. Database (defaults to persistent SQLite in named volume)
DATABASE_URL=sqlite:///./mindcare.db
